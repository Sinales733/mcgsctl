{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gedyrione-ux.github.io/mcgsctl/schemas/layout.schema.json",
  "title": "mcgsctl HMI Layout",
  "type": "object",
  "required": ["schemaVersion", "canvas"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "windowIndex": { "type": "integer", "minimum": 0 },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "grid": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "properties": {
        "buttonWidth": { "type": "integer", "minimum": 1 },
        "buttonHeight": { "type": "integer", "minimum": 1 },
        "statusWidth": { "type": "integer", "minimum": 1 },
        "statusHeight": { "type": "integer", "minimum": 1 },
        "titleHeight": { "type": "integer", "minimum": 1 },
        "labelHeight": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "anyOf": [
    { "required": ["objects"] },
    { "required": ["sections"] }
  ],
  "additionalProperties": true,
  "$defs": {
    "rect": {
      "type": "object",
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "object": {
      "allOf": [
        { "$ref": "#/$defs/rect" },
        {
          "type": "object",
          "required": ["id", "kind", "text"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": {
              "type": "string",
              "enum": ["section-title", "static-label", "momentary-button", "status-button"]
            },
            "text": { "type": "string", "minLength": 1 },
            "variable": { "type": "string" },
            "expression": { "type": "string" },
            "renderAs": { "type": "string", "enum": ["status-button", "preview-only"] },
            "windowIndex": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      ]
    },
    "section": {
      "allOf": [
        { "$ref": "#/$defs/rect" },
        {
          "type": "object",
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "titleRenderAs": { "type": "string", "enum": ["status-button", "preview-only"] },
            "layout": { "type": "string", "enum": ["direction-pad", "row"] },
            "controls": {
              "type": "array",
              "items": { "$ref": "#/$defs/sectionControl" }
            },
            "indicators": {
              "type": "array",
              "items": { "$ref": "#/$defs/sectionIndicator" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "sectionControl": {
      "type": "object",
      "required": ["id", "kind", "text", "variable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["momentary-button"] },
        "text": { "type": "string", "minLength": 1 },
        "variable": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "enum": ["up", "down", "left", "right", "center"] },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "sectionIndicator": {
      "type": "object",
      "required": ["id", "kind", "text", "expression"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["status-button"] },
        "text": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
